// MIR for `switch_loop` after SimplifyCfg-initial

fn switch_loop() -> () {
    let mut _0: ();
    let mut _1: ();
    let mut _2: bool;
    let mut _3: !;

    bb0: {
        goto -> bb1;
    }

    bb1: {
